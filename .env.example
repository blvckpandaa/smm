DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AUTH_SECRET=change-me-to-a-long-random-string

# Pollinations — фото работает и без ключа; видео требует ключ
# https://enter.pollinations.ai
# POLLINATIONS_API_KEY=

# Meta (Facebook / Instagram / Threads) — тесты с ngrok
META_APP_ID=
META_APP_SECRET=
APP_URL=https://smm-agents.ru
# Без ключей Meta автоматически включается режим заглушки.
# META_USE_STUB=1 — принудительно заглушка даже с ключами

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=

# VK — автоподключение сообществ через OAuth
# Достаточно VK_APP_ID + VK_APP_SECRET (OAuth сообщества через oauth.vk.com).
# Опционально VK_OAUTH_APP_ID — legacy-приложение «Веб-сайт» для выбора из списка сообществ.
VK_APP_ID=
VK_APP_SECRET=
VK_OAUTH_APP_ID=
VK_OAUTH_APP_SECRET=

# ЮKassa — пополнение баланса (без ключей работает демо-пополнение)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ (обязателен, если в кабинете включены «Чеки от ЮKassa»)
# vat_code: 1=без НДС, 2=0%, 3=10%, 4=20%, 5=10/110, 6=20/120, 7=5%, 8=7% …
YOOKASSA_VAT_CODE=1
# tax_system_code: 1=ОСН, 2=УСН доход, 3=УСН доход-расход, 4=ЕНВД, 5=ЕСХН, 6=патент
# YOOKASSA_TAX_SYSTEM_CODE=2
# Webhook URL в кабинете ЮKassa: https://smm-agents.ru/api/billing/webhook
