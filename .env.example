DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AUTH_SECRET=change-me-to-a-long-random-string

# Pollinations — без ключа фото часто ловит 429 (очередь 1 запрос на IP).
# Ключ sk_ с https://enter.pollinations.ai снимает лимит и нужен для видео.
# POLLINATIONS_API_KEY=

# Meta (Facebook / Instagram / Threads) — тесты с ngrok
META_APP_ID=
META_APP_SECRET=
APP_URL=https://smm-agents.ru
# Для локальной разработки UI: http://localhost:3000
# Callback VK / TG webhook требуют публичный URL (прод).

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=

# VK — приложение типа «Веб-сайт» на https://vk.com/apps?act=manage
# (не мини-приложение из «Продукты VK» — иначе Security Error / blank.html)
# В настройках → Redirect URI добавьте ТОЧНО:
#   http://localhost:3000/api/vk/callback
#   https://smm-agents.ru/api/vk/callback
# Тогда «Подключить VK» работает без копирования из адресной строки.
VK_APP_ID=
VK_APP_SECRET=
# Опционально отдельный legacy app id
VK_OAUTH_APP_ID=
VK_OAUTH_APP_SECRET=

# ЮKassa — пополнение баланса (без ключей работает демо-пополнение)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ (обязателен, если в кабинете включены «Чеки от ЮKassa»)
# vat_code: 1=без НДС, 2=0%, 3=10%, 4=20%, 5=10/110, 6=20/120, 7=5%, 8=7% …
YOOKASSA_VAT_CODE=1
# tax_system_code: 1=ОСН, 2=УСН доход, 3=УСН доход-расход, 4=ЕНВД, 5=ЕСХН, 6=патент
# YOOKASSA_TAX_SYSTEM_CODE=2
# Webhook URL в кабинете ЮKassa: https://smm-agents.ru/api/billing/webhook
