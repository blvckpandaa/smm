DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AUTH_SECRET=change-me-to-a-long-random-string

# Pollinations — фото работает и без ключа; видео требует ключ
# https://enter.pollinations.ai
# POLLINATIONS_API_KEY=

# Meta (Facebook / Instagram / Threads) — тесты с ngrok
META_APP_ID=
META_APP_SECRET=
APP_URL=https://smm-agents.ru
# Без ключей Meta автоматически включается режим заглушки.
# META_USE_STUB=1 — принудительно заглушка даже с ключами

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=

# VK OAuth — подключение сообщества в один клик
# https://dev.vk.com/ — тип приложения «Веб-сайт» или Standalone
VK_APP_ID=
VK_APP_SECRET=
# Без ключей VK автоматически включается режим заглушки (тестовый выбор сообщества)
# VK_USE_STUB=1

# ЮKassa — пополнение баланса (без ключей работает демо-пополнение)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Webhook URL в кабинете ЮKassa: https://smm-agents.ru/api/billing/webhook
