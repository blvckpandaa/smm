DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AUTH_SECRET=change-me-to-a-long-random-string

# Pollinations — фото работает и без ключа; видео требует ключ
# https://enter.pollinations.ai
# POLLINATIONS_API_KEY=

# Meta (Facebook / Instagram / Threads) — тесты с ngrok
META_APP_ID=
META_APP_SECRET=
APP_URL=http://localhost:3000
# Без ключей Meta автоматически включается режим заглушки.
# META_USE_STUB=1 — принудительно заглушка даже с ключами

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
